# Reference only: Settings never loads dotenv files automatically.
# Use scripts/workspace_command.py to select the private local dev/test target.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8305
APP_DEBUG=false
API_BASE_PATH=/api/v1
AUTH_PROVIDER=local
AUTH_COOKIE_NAME=digital_asset_platform_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=43200
AUTH_IDLE_SECONDS=1800
AUTH_RECENT_SECONDS=900
# Generate privately; do not commit a working initialization token or master key.
# AUTH_BOOTSTRAP_TOKEN=<random-at-least-32-characters>
# CREDENTIAL_MASTER_KEY=<URL-safe-base64-encoded-32-byte-key>
CREDENTIAL_KEY_VERSION=key-1
# During reviewed offline rotation only: JSON map of old key version to key.
# CREDENTIAL_READ_KEYS={"old-version":"<old-URL-safe-base64-key>"}
# Must be outside the web/static directory; workspace provisioning configures it.
# PRIVATE_FILE_ROOT=D:/private/digital-asset-platform/files
ATTACHMENT_SCAN_REQUIRED=false
ALLOWED_ORIGINS=["http://127.0.0.1:5175","http://localhost:5175"]
TRUSTED_HOSTS=["127.0.0.1","localhost"]
DATABASE_URL=postgresql+psycopg://dap_workspace_dev_runtime:CHANGE_ME@127.0.0.1:55433/digital_asset_platform_workspace_dev
EXPECTED_DATABASE=digital_asset_platform_workspace_dev
INSTANCE_ID=digital-asset-platform-workspace-dev
# Migrator is a separate process and role; never give these values to web workers.
MIGRATOR_DATABASE_URL=postgresql+psycopg://dap_workspace_dev_migrator:CHANGE_ME@127.0.0.1:55433/digital_asset_platform_workspace_dev
RUNTIME_DATABASE_USER=dap_workspace_dev_runtime

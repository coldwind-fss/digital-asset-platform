# Compatibility EnvironmentFile example. New multi-instance installs use the
# private app.json/migration.json runner and @ units documented in RUNBOOK.md.
APP_ENV=production
APP_NAME=数字资产管理中台 API
APP_HOST=127.0.0.1
APP_PORT=8300
APP_DEBUG=false
AUTH_PROVIDER=local
AUTH_COOKIE_SECURE=true
APP_READ_ONLY=false
# For a reviewed local-account server deployment use AUTH_PROVIDER=local,
# AUTH_COOKIE_SECURE=true and privately inject AUTH_BOOTSTRAP_TOKEN for setup.
# AUTH_COOKIE_NAME=digital_asset_platform_session
# AUTH_SESSION_SECONDS=43200
# AUTH_IDLE_SECONDS=1800
# AUTH_RECENT_SECONDS=900
ALLOWED_ORIGINS=["https://app.example.com"]
TRUSTED_HOSTS=["app.example.com","127.0.0.1"]
# 独立数据库占位配置；部署前从受管配置注入，不能复用旧环境。
DATABASE_URL=postgresql+psycopg://digital_asset_platform_runtime:CHANGE_ME@127.0.0.1:5432/digital_asset_platform
EXPECTED_DATABASE=digital_asset_platform
INSTANCE_ID=REPLACE_WITH_UNIQUE_INSTANCE_ID
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# 应用层 AES-256-GCM 主密钥：由受管密钥系统注入，不写入仓库或普通 .env。
# CREDENTIAL_MASTER_KEY=<URL-safe-base64-encoded-32-byte-key>
CREDENTIAL_KEY_VERSION=key-1
# CREDENTIAL_READ_KEYS={"old-version":"<privately-managed-old-key>"}
PRIVATE_FILE_ROOT=/var/lib/digital-asset-platform/private-files
# Local checks validate types/signatures, not antivirus. true requires a scanner.
ATTACHMENT_SCAN_REQUIRED=false

# Replace @@...@@ using reviewed instance parameters. Keep other applications.
server {
    listen @@PORT@@ ssl;
    server_name @@HOST@@;
    ssl_certificate @@CERT@@;
    ssl_certificate_key @@KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/digital-asset-platform/current/frontend/dist;
    charset utf-8;
    client_max_body_size 10m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control no-store always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:@@API_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 504 =503 @api_unavailable;
        error_page 413 =413 @api_too_large;
    }
    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control no-store always;
        add_header X-Request-ID $request_id always;
        return 503 '{"data":null,"error":{"code":"DEPENDENCY_UNAVAILABLE","message":"Service temporarily unavailable","details":[],"retryable":true},"meta":{"request_id":"$request_id"}}';
    }
    location @api_too_large {
        default_type application/json;
        add_header Cache-Control no-store always;
        add_header X-Request-ID $request_id always;
        return 413 '{"data":null,"error":{"code":"UPLOAD_TOO_LARGE","message":"File exceeds 10 MiB","details":[],"retryable":false},"meta":{"request_id":"$request_id"}}';
    }
    error_page 413 =413 @api_too_large;
    location ~ /\. { deny all; }
    location /assets/ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

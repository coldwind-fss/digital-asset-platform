# Same-origin Vite proxy target for the Digital Asset Platform API.
VITE_API_BASE_URL=/api/v1
# Local workspace launcher supplies 8305; preserved V2 preview uses 8300.
VITE_API_PROXY_TARGET=http://127.0.0.1:8305

# Optional deliberately PUBLIC sample login, compiled into the frontend.
# Never put real owner credentials here. Blank keeps normal local initialization.
VITE_SAMPLE_USERNAME=
VITE_SAMPLE_PASSWORD=
VITE_SAMPLE_REVIEWER_USERNAME=
VITE_SAMPLE_REVIEWER_PASSWORD=

# Development/test only. Leave blank in staging/production and use the real identity adapter.
VITE_TEST_SUBJECT=
VITE_TEST_CAPABILITIES=resource.read,resource.write,directory.read,governance.read,governance.write,governance.confirm,materials.read,materials.write
